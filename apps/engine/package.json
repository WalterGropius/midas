{
  "name": "@midas/engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The MIDAS harness: stateless workers over the SpacetimeDB ledger \u2014 ingest, reflexes, swarm, deliberation, decisions, execution, learning.",
  "scripts": {
    "start": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "seed:import": "node --env-file-if-exists=../../.env --import tsx src/seed-import.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "token": "node --env-file-if-exists=../../.env --import tsx src/print-token.ts",
    "mcp": "node --import tsx src/mcp.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@midas/core": "*",
    "@midas/stdb-bindings": "*",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "fast-xml-parser": "^5.11.1",
    "spacetimedb": "2.10.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@polymarket/clob-client-v2": "^1.2.0",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
