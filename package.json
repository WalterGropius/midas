{
  "name": "midas",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-agent, self-evolving prediction-market trading harness: news -> reaction forecasts -> EV-sized trades on Polymarket, with graph memory in SpacetimeDB.",
  "type": "module",
  "workspaces": [
    "spacetimedb",
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "stdb:start": "spacetime start",
    "stdb:build": "spacetime build --module-path spacetimedb",
    "stdb:publish:local": "spacetime publish midas --module-path spacetimedb --server local --yes",
    "stdb:publish": "spacetime publish midas --module-path spacetimedb --yes",
    "stdb:generate": "spacetime generate --lang typescript --out-dir packages/stdb-bindings/src --module-path spacetimedb --yes",
    "engine": "npm run start -w @midas/engine",
    "engine:dev": "npm run dev -w @midas/engine",
    "web": "npm run dev -w @midas/web",
    "seed:import": "npm run seed:import -w @midas/engine --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @midas/web",
    "engine:token": "npm run token -w @midas/engine"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
