# ─────────────────────────────────────────────────────────────────────────────
# MIDAS configuration. Copy to .env for local runs; on Modal put the same keys
# in the `midas-engine` secret; on Vercel only the NEXT_PUBLIC_* ones matter.
# Every value has a default in apps/engine/src/config.ts — only set what differs.
# ─────────────────────────────────────────────────────────────────────────────

# ── SpacetimeDB (all state lives here)
MIDAS_STDB_URI=ws://127.0.0.1:3000            # Maincloud: wss://maincloud.spacetimedb.com
MIDAS_STDB_DB=midas
# MIDAS_STDB_TOKEN=                            # stable engine identity (npm run engine:token); required on Modal

# ── Web UI (Vercel, static export)
NEXT_PUBLIC_STDB_URI=ws://127.0.0.1:3000
NEXT_PUBLIC_STDB_DB=midas
# NEXT_PUBLIC_ENGINE_URL=https://<workspace>--midas-engine-engine-serve.modal.run

# ── Model access: set GEMINI_API_KEY, or AI_GATEWAY_API_KEY alone (Vercel AI
#    Gateway then serves Gemini, Jev, embeddings and alt models with one key)
GEMINI_API_KEY=
# AI_GATEWAY_API_KEY=                          # https://vercel.com/ai-gateway (Jev = typesafe-ai/jev)
# MIDAS_GEMINI_VIA=auto                        # auto | direct | gateway
# MIDAS_GATEWAY_SEARCH=perplexity              # grounding for Pro via gateway: perplexity | exa | parallel | tako | none

# ── Gemini (System 2: Flash swarm, Pro supervisor, coach, wiki)
# MIDAS_GEMINI_FLASH=gemini-3.8-flash
# MIDAS_GEMINI_FLASH_LITE=gemini-3.5-flash-lite
# MIDAS_GEMINI_PRO=gemini-3.1-pro-preview
# MIDAS_GEMINI_EMBED=gemini-embedding-2
# MIDAS_GEMINI_BASE_URL=                       # direct client via a proxy; tests point it at apps/engine/scripts/mock-gemini.mjs
# MIDAS_LLM_DAILY_BUDGET_USD=25                # hard daily stop for all LLM spend
# MIDAS_ALT_MODELS=anthropic/claude-sonnet-5  # optional 2nd model family (gateway ids with AI_GATEWAY_API_KEY, else OpenRouter ids)

# ── System 1 (fast typed decisions). auto = jev → jev-gateway → jev-openrouter → laya → flash → heuristic
# MIDAS_S1_PROVIDER=auto
# TYPESAFE_API_KEY=                            # Jev direct (https://api.typesafe.ai/v1/systemone)
#                                              # (with AI_GATEWAY_API_KEY Jev needs no key of its own)
# OPENROUTER_API_KEY=                          # Jev via OpenRouter, and MIDAS_ALT_MODELS
# MIDAS_LAYA_URL=                              # self-hosted Laya; defaults to MIDAS_MODAL_URL

# ── Modal intel service (TimesFM 2.5 + Laya), see modal/README.md
# MIDAS_MODAL_URL=https://<workspace>--midas-intel-api.modal.run
# MIDAS_MODAL_TOKEN=

# ── Connectors (bidirectional)
# MIDAS_CONTROL_TOKEN=                         # bearer token for the engine control API (/api/*)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHATS=123456789             # chat ids allowed to command the engine
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# MIDAS_WEBHOOKS=https://example.com/hook      # generic JSON webhooks (comma-separated)
# MIDAS_ALERT_KINDS=trade,risk,error,lesson,evolution
# MIDAS_RSS_EXTRA=https://example.com/feed.xml # extra feeds for every session

# ── Venues
# MANIFOLD_API_KEY=                            # play-money sandbox for the live order path

# ── LIVE TRADING (real money). Paper trading needs none of this.
# Triple gate: this flag + admin approval per session + readiness gate
# (300+ resolved forecasts beating the market, ECE < 0.05, paper PnL CI > 0).
MIDAS_LIVE_TRADING=false
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_FUNDER=                           # proxy/deposit wallet address
# POLYMARKET_SIGNATURE_TYPE=3                  # 0 EOA, 1 POLY_PROXY, 2 GNOSIS_SAFE, 3 POLY_1271 (deposit wallet)
# MIDAS_LIVE_MAX_ORDER_USD=25
# MIDAS_LIVE_MAX_BANKROLL_USD=500
# MIDAS_LIVE_REQUIRE_READINESS=true

# ── Engine topology
# MIDAS_ROLE=all                               # all | leader | worker
# MIDAS_HTTP_PORT=8080
